{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/intervention-sample-planner/schemas/study_config.schema.json",
  "title": "Intervention Sample Planner Study Configuration",
  "description": "JSON Schema for Intervention Sample Planner v2.4. File version 2.4; date 2026-05-30.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "_file_version": {
      "type": "string",
      "default": "2.4"
    },
    "_file_date": {
      "type": "string",
      "format": "date",
      "default": "2026-05-30"
    },
    "study_name": {
      "type": "string",
      "default": "Untitled intervention study"
    },
    "language": {
      "type": "string",
      "enum": ["en", "pt"],
      "default": "en"
    },
    "workflow_path": {
      "type": "string",
      "enum": ["plan_study", "evaluate_done", "evaluate_against_plan"],
      "default": "plan_study"
    },
    "study_design": {
      "type": "string",
      "enum": ["parallel_two_group", "pretest_posttest_control", "one_group_pre_post", "one_group_post_survey", "stratified_post_survey"],
      "default": "parallel_two_group"
    },
    "analysis_mode": {
      "type": "string",
      "enum": ["plan", "evaluate"],
      "default": "plan"
    },
    "analysis_unit": {
      "type": "string",
      "default": "person"
    },
    "observation_unit": {
      "type": "string",
      "default": "person"
    },
    "outcome_type": {
      "type": "string",
      "enum": ["continuous", "binary"],
      "default": "continuous"
    },
    "alternative": {
      "type": "string",
      "enum": ["two_sided", "greater", "less"],
      "default": "two_sided"
    },
    "alpha": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1,
      "default": 0.05
    },
    "power": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1,
      "default": 0.8
    },
    "primary_comparisons": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "allocation_ratio": {
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 1.0
    },
    "effect_size_d": {
      "type": ["number", "null"],
      "exclusiveMinimum": 0,
      "default": 0.5
    },
    "mean_control": {
      "type": ["number", "null"],
      "default": null
    },
    "mean_intervention": {
      "type": ["number", "null"],
      "default": null
    },
    "sd_pooled": {
      "type": ["number", "null"],
      "exclusiveMinimum": 0,
      "default": null
    },
    "pre_post_correlation": {
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 1,
      "default": 0.5
    },
    "proportion_control": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1,
      "default": 0.45
    },
    "proportion_intervention": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1,
      "default": 0.6
    },
    "survey_analysis_goal": {
      "type": "string",
      "enum": ["favorable_proportion", "mean_score"],
      "default": "favorable_proportion"
    },
    "survey_scale_min": {
      "type": "number",
      "default": 1.0
    },
    "survey_scale_max": {
      "type": "number",
      "default": 5.0
    },
    "survey_scale_points": {
      "type": "integer",
      "minimum": 2,
      "default": 5
    },
    "survey_favorable_threshold": {
      "type": "number",
      "default": 4.0
    },
    "survey_target_proportion": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1,
      "default": 0.7
    },
    "survey_expected_proportion": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1,
      "default": 0.5
    },
    "survey_margin_of_error": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1,
      "default": 0.05
    },
    "survey_expected_sd": {
      "type": ["number", "null"],
      "exclusiveMinimum": 0,
      "default": null
    },
    "survey_mean_margin_of_error": {
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 0.2
    },
    "survey_target_mean": {
      "type": ["number", "null"],
      "default": null
    },
    "strata_definition": {
      "type": "string",
      "default": "",
      "description": "JSON object or list defining demographic strata with labels, population_n or population_proportion, and optional target_valid_n."
    },
    "stratified_allocation_method": {
      "type": "string",
      "enum": ["proportional", "equal", "minimum_per_stratum", "manual"],
      "default": "proportional"
    },
    "stratified_min_per_stratum": {
      "type": "integer",
      "minimum": 1,
      "default": 30
    },
    "stratified_target_total": {
      "type": ["integer", "null"],
      "minimum": 1,
      "default": null
    },
    "stratified_population_known": {
      "type": "boolean",
      "default": true
    },
    "stratified_use_weights": {
      "type": "boolean",
      "default": true
    },
    "apply_fpc": {
      "type": "boolean",
      "default": false
    },
    "finite_population": {
      "type": ["integer", "null"],
      "minimum": 1,
      "default": null
    },
    "cluster_average_size": {
      "type": "number",
      "minimum": 1,
      "default": 1.0
    },
    "intraclass_correlation": {
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 1,
      "default": 0.0
    },
    "response_rate": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1,
      "default": 1.0
    },
    "completion_rate": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1,
      "default": 1.0
    },
    "usable_data_rate": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1,
      "default": 1.0
    },
    "extra_buffer_rate": {
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 1,
      "default": 0.0
    },
    "observed_control_n": {
      "type": ["integer", "null"],
      "minimum": 1,
      "default": null
    },
    "observed_intervention_n": {
      "type": ["integer", "null"],
      "minimum": 1,
      "default": null
    },
    "observed_total_n": {
      "type": ["integer", "null"],
      "minimum": 1,
      "default": null
    },
    "observed_control_events": {
      "type": ["integer", "null"],
      "minimum": 0,
      "default": null
    },
    "observed_intervention_events": {
      "type": ["integer", "null"],
      "minimum": 0,
      "default": null
    },
    "observed_pre_success_post_failure": {
      "type": ["integer", "null"],
      "minimum": 0,
      "default": null,
      "description": "Paired binary one-group count: pre-test success followed by post-test failure."
    },
    "observed_pre_failure_post_success": {
      "type": ["integer", "null"],
      "minimum": 0,
      "default": null,
      "description": "Paired binary one-group count: pre-test failure followed by post-test success."
    },
    "observed_effect_size": {
      "type": ["number", "null"],
      "default": null
    },
    "observed_survey_counts": {
      "type": "string",
      "default": ""
    },
    "observed_survey_favorable_count": {
      "type": ["integer", "null"],
      "minimum": 0,
      "default": null
    },
    "observed_survey_mean": {
      "type": ["number", "null"],
      "default": null
    },
    "observed_survey_sd": {
      "type": ["number", "null"],
      "exclusiveMinimum": 0,
      "default": null
    },
    "observed_strata_counts": {
      "type": "string",
      "default": "",
      "description": "JSON object or list containing achieved valid_n, missing_n, favorable count, mean/SD, or response-count histogram per stratum."
    },
    "had_planned_sample": {
      "type": "boolean",
      "default": false
    },
    "planned_control_n": {
      "type": ["integer", "null"],
      "minimum": 1,
      "default": null
    },
    "planned_intervention_n": {
      "type": ["integer", "null"],
      "minimum": 1,
      "default": null
    },
    "planned_total_n": {
      "type": ["integer", "null"],
      "minimum": 1,
      "default": null
    },
    "planned_effect_size": {
      "type": ["number", "null"],
      "exclusiveMinimum": 0,
      "default": null
    },
    "planned_alpha": {
      "type": ["number", "null"],
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1,
      "default": null
    },
    "planned_power": {
      "type": ["number", "null"],
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1,
      "default": null
    },
    "intervention_label": {
      "type": "string",
      "default": "Intervention"
    },
    "control_label": {
      "type": "string",
      "default": "Control"
    },
    "notes": {
      "type": "string",
      "default": ""
    },
    "range_override_fields": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "source_case": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "study_name",
    "language",
    "workflow_path",
    "study_design",
    "analysis_mode",
    "analysis_unit",
    "observation_unit",
    "outcome_type",
    "alternative",
    "alpha",
    "power",
    "primary_comparisons",
    "allocation_ratio",
    "pre_post_correlation",
    "proportion_control",
    "proportion_intervention",
    "strata_definition",
    "stratified_allocation_method",
    "stratified_min_per_stratum",
    "stratified_population_known",
    "stratified_use_weights",
    "apply_fpc",
    "cluster_average_size",
    "intraclass_correlation",
    "response_rate",
    "completion_rate",
    "usable_data_rate",
    "extra_buffer_rate",
    "intervention_label",
    "control_label",
    "notes",
    "range_override_fields"
  ]
}
