{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/intervention-sample-planner/schemas/study_config.schema.json",
  "title": "Intervention Sample Planner Study Configuration",
  "description": "JSON Schema for Intervention Sample Planner v2.0. File version 2.0; date 2026-05-11.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "_file_version": {
      "type": "string",
      "default": "2.0"
    },
    "_file_date": {
      "type": "string",
      "format": "date",
      "default": "2026-05-11"
    },
    "study_name": {
      "type": "string",
      "default": "Untitled intervention study"
    },
    "language": {
      "type": "string",
      "enum": ["en", "pt"],
      "default": "en"
    },
    "study_design": {
      "type": "string",
      "enum": ["parallel_two_group", "pretest_posttest_control", "one_group_pre_post"],
      "default": "parallel_two_group"
    },
    "analysis_mode": {
      "type": "string",
      "enum": ["plan", "evaluate"],
      "default": "plan"
    },
    "analysis_unit": {
      "type": "string",
      "default": "person"
    },
    "observation_unit": {
      "type": "string",
      "default": "person"
    },
    "outcome_type": {
      "type": "string",
      "enum": ["continuous", "binary"],
      "default": "continuous"
    },
    "alternative": {
      "type": "string",
      "enum": ["two_sided", "greater", "less"],
      "default": "two_sided"
    },
    "alpha": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1,
      "default": 0.05
    },
    "power": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1,
      "default": 0.8
    },
    "primary_comparisons": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "allocation_ratio": {
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 1.0
    },
    "effect_size_d": {
      "type": ["number", "null"],
      "exclusiveMinimum": 0,
      "default": 0.5
    },
    "mean_control": {
      "type": ["number", "null"],
      "default": null
    },
    "mean_intervention": {
      "type": ["number", "null"],
      "default": null
    },
    "sd_pooled": {
      "type": ["number", "null"],
      "exclusiveMinimum": 0,
      "default": null
    },
    "pre_post_correlation": {
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 1,
      "default": 0.5
    },
    "proportion_control": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1,
      "default": 0.45
    },
    "proportion_intervention": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1,
      "default": 0.6
    },
    "apply_fpc": {
      "type": "boolean",
      "default": false
    },
    "finite_population": {
      "type": ["integer", "null"],
      "minimum": 1,
      "default": null
    },
    "cluster_average_size": {
      "type": "number",
      "minimum": 1,
      "default": 1.0
    },
    "intraclass_correlation": {
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 1,
      "default": 0.0
    },
    "response_rate": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1,
      "default": 1.0
    },
    "completion_rate": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1,
      "default": 1.0
    },
    "usable_data_rate": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1,
      "default": 1.0
    },
    "extra_buffer_rate": {
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 1,
      "default": 0.0
    },
    "observed_control_n": {
      "type": ["integer", "null"],
      "minimum": 1,
      "default": null
    },
    "observed_intervention_n": {
      "type": ["integer", "null"],
      "minimum": 1,
      "default": null
    },
    "observed_total_n": {
      "type": ["integer", "null"],
      "minimum": 1,
      "default": null
    },
    "observed_effect_size": {
      "type": ["number", "null"],
      "default": null
    },
    "intervention_label": {
      "type": "string",
      "default": "Intervention"
    },
    "control_label": {
      "type": "string",
      "default": "Control"
    },
    "notes": {
      "type": "string",
      "default": ""
    },
    "range_override_fields": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "source_case": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "study_name",
    "language",
    "study_design",
    "analysis_mode",
    "analysis_unit",
    "observation_unit",
    "outcome_type",
    "alternative",
    "alpha",
    "power",
    "primary_comparisons",
    "allocation_ratio",
    "pre_post_correlation",
    "proportion_control",
    "proportion_intervention",
    "apply_fpc",
    "cluster_average_size",
    "intraclass_correlation",
    "response_rate",
    "completion_rate",
    "usable_data_rate",
    "extra_buffer_rate",
    "intervention_label",
    "control_label",
    "notes",
    "range_override_fields"
  ]
}
